{
  "_about": "Published MBBS fees read by hand from official notices, one row per college and seat type. Amounts are rupees per year. Each source names the document it came from, so it can be checked again.",
  "sources": {
    "OR-2026": {
      "label": "OJEE's Round 3 admission notice, 2026",
      "title": "OJEE, Schedule and Instructions for Provisional Admission to MBBS/BDS (3rd Round Counselling), 2026, section C, Fee structure",
      "url": "https://odishajee.com/news_document/Notice_3rd_round_Reporting_R_560.pdf",
      "note": "Government colleges: Rs. 37,950 per annum. NRI candidates pay four times the private college fee, as the notice states, so those rows are worked out from it."
    },
    "PY-2026": {
      "label": "Puducherry's fee order of 28 August 2026",
      "title": "Government of Puducherry, Chief Secretariat (Health), Order No.225/H5/Health-II/2026-27 dated 28.08.2026, Approved Fee Structure for UG Medical course, 2026-27 to 2028-29",
      "url": "https://drive.google.com/file/d/1ulK5ZSkqgWfZT6NwCN5LBkYD13GrOJbK/view",
      "note": "Covers PIMS and SMVMCH. Sri Venkateshwaraa's fee is governed by a High Court interim stay, so it isn't listed."
    },
    "UP-2026": {
      "label": "UP's fee orders for 2026-27, on upneet.gov.in",
      "title": "Government of Uttar Pradesh, Chikitsa Shiksha Anubhag-4, fee fixation notifications for MBBS, academic session 2026-27, one per college (for example No. 175/71-4099/89/2026 dated 01.09.2026), published by DGME on upneet.gov.in as \"Fee Fixation GO for Academic Session of UPNEET UG 2026-27 in MBBS Course\"",
      "url": "https://upneet.gov.in/",
      "note": "Tuition fee only. Hostel, security deposit and other charges stay as in 2025-26. The documents open from the notices on the home page, which have no direct address. Prasad Medical College (Unnao), Radha Govind (Meerut) and Mayo (Barabanki) are in the orders but not on this site."
    },
    "UP-MIN-2026": {
      "label": "Minority colleges' fee statements, UP NEET UG 2026, on upneet.gov.in",
      "title": "UP NEET UG-2026 Fee Structure, Minority Private Medical Colleges, U.P., for MBBS Course: each college's letter to DGME (Teerthanker Mahaveer 11.08.2026, F.H. 07.08.2026, Career 06.08.2026, Era 10.08.2026)",
      "url": "https://upneet.gov.in/",
      "note": "Minority colleges set their own fee and declare it to DGME, which publishes the letters. Tuition fee only."
    },
    "UP-IIMSR-2026": {
      "label": "Integral's revised MBBS fee, UP NEET UG 2026, on upneet.gov.in",
      "title": "Integral Institute of Medical Sciences & Research, Ref. IIMSR/DO/2026/2740 dated 02.09.2026, Revised MBBS Fee Structure for NEET UG 2026-27, published by DGME on upneet.gov.in",
      "url": "https://upneet.gov.in/",
      "note": "Tuition fee only."
    },
    "UP-ESIC-2026": {
      "label": "ESIC Noida and Varanasi fee structure, UP NEET UG 2026, on upneet.gov.in",
      "title": "Fee Structure of ESIC Medical College and Hospital, Noida and Varanasi for UP NEET UG 2026-27, published by DGME on upneet.gov.in",
      "url": "https://upneet.gov.in/",
      "note": "Tuition for state and All India quota seats. Insured-person (IP quota) seats pay Rs. 24,000, which the site has no seat type for."
    },
    "MP-2026": {
      "label": "DME Madhya Pradesh's college fee report, UG counselling 2026",
      "title": "Directorate of Medical Education, Madhya Pradesh, MP State Combined U.G. Counselling-2026, Subject Fee Details (UG) report, MBBS, all institutes",
      "url": "https://dme.mponline.gov.in/Portal/Services/DMEMP/College/RptSubjectFeeDetailsUG.aspx",
      "note": "Tuition fee per year. Private colleges also charge a development and miscellaneous fee (about 15 to 18% of tuition) and a Rs. 25,000 caution deposit, which are left out. Government colleges also take Rs. 14,000 caution money (Rs. 5,000 at ESIC Indore). Read on 6 November 2026."
    },
    "TN-2026": {
      "label": "Tamil Nadu's MBBS/BDS prospectus 2026-27",
      "title": "Selection Committee, Directorate of Medical Education and Research, Tamil Nadu, Prospectus for admission to MBBS/BDS 2026-2027 session, section 22, Fee Structure (pages 55 to 58)",
      "url": "https://tnmedicalselection.net/news/30062026003157.pdf",
      "note": "Government colleges: tuition Rs. 6,000 a year; with special, library, university and other fees the yearly total is Rs. 18,073. Self-financing colleges: the fee for a government quota seat as fixed by the Fee Committee. Management and NRI quota fees are in the separate management quota prospectus and aren't included."
    }
  },
